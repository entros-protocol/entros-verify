{
  "name": "@entros/verify-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "End-to-end example integrator for @entros/verify. Wires the package against a localhost popup host for development and integrator reference.",
  "scripts": {
    "dev": "vite --port 3001",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3001",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@entros/verify": "file:..",
    "@solana/web3.js": "^1.95.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
