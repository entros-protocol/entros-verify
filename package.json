{
  "name": "@entros/verify",
  "version": "1.0.0",
  "description": "Live human-presence and cryptographic consent firewall SDK for Voice-AI and autonomous MCP agents",
  "license": "MIT",
  "homepage": "https://entros.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entros-protocol/entros-verify.git"
  },
  "bugs": {
    "url": "https://github.com/entros-protocol/entros-verify/issues"
  },
  "keywords": [
    "entros",
    "voice-liveness",
    "voice-ai",
    "mcp",
    "agent-permit",
    "passkey",
    "webauthn",
    "scitt",
    "consent",
    "verification",
    "solana"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.mjs",
      "require": "./dist/policy.js"
    },
    "./agent-permit": {
      "types": "./dist/agent-permit.d.ts",
      "import": "./dist/agent-permit.mjs",
      "require": "./dist/agent-permit.js"
    },
    "./solana": {
      "types": "./dist/solana.d.ts",
      "import": "./dist/solana.mjs",
      "require": "./dist/solana.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.mjs",
      "require": "./dist/mcp.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check-licenses": "node scripts/check-licenses.mjs",
    "verify-publish-contents": "node scripts/verify-publish-contents.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run check-licenses && npm run build && npm run verify-publish-contents"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "jose": "^6.2.18"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.2",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
